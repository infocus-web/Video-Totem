{
  "name": "autoreel-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "desktop:exe": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "0.546.0",
    "mediabunny": "1.61.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "electron/main.cjs",
  "description": "Editor local de videos para tótems y entradas de quince",
  "author": "InFocus"
}
